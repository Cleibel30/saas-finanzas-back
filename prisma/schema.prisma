// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// --- ENUMS ---

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CategoryType {
  OPERATING
  INVESTING
  FINANCING
}

enum FlowDirection {
  INFLOW
  OUTFLOW
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum CategoryItemScope {
  PRODUCT
  SERVICE
  NONE
}

enum BatchStatus {
  OPEN
  CLOSED
}

enum StockEffect {
  INCREMENT
  DECREMENT
  NONE
}

enum TransactionStatus {
  PENDING
  COMPLETED
}

enum PaymentMethod {
  PAGO_MOVIL
  TARJETA_DEBITO_CREDITO_PUNTO_VENTA
  TRANSFERENCIA_BANCARIA_NACIONAL
  EFECTIVO_BOLIVARES
  EFECTIVO_DIVISAS
  TRANSFERENCIAS_INTERNACIONALES_DIRECTAS
  BILLETERAS_ELECTRONICAS_PROCESADORES
  CRIPTOMONEDAS
}

enum Currency {
  BOLIVARES
  DOLARES
}

// --- MODELS ---

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         UserRole  @default(USER) @map("role")
  tokenBalance Int       @default(0) @map("token_balance")
  isSuspended  Boolean   @default(false) @map("is_suspended")
  suspendedAt  DateTime? @map("suspended_at")
  isRemoved    Boolean   @default(false) @map("is_removed")
  createdAt    DateTime  @default(now()) @map("created_at")

  subscriptions Subscription[]
  companies     Company[]

  @@map("users")
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  maxCompanies Int      @map("max_companies")
  price        Decimal  @db.Decimal(10, 2)
  isPremium    Boolean  @default(false) @map("is_premium")
  isRemoved    Boolean  @default(false) @map("is_removed")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus
  endDate   DateTime           @map("end_date")
  isRemoved Boolean            @default(false) @map("is_removed")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Company {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  cashBalanceUSD  Decimal   @default(0) @map("cash_balance_usd") @db.Decimal(15, 2)
  cashBalanceBs   Decimal   @default(0) @map("cash_balance_bs") @db.Decimal(15, 2)
  isSuspended     Boolean   @default(false) @map("is_suspended")
  suspendedAt     DateTime? @map("suspended_at")
  isRemoved       Boolean   @default(false) @map("is_removed")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  categories        Category[]
  items             Item[]
  productionBatches ProductionBatch[]
  transactions      Transaction[]

  @@map("companies")
}

model Category {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String?             @map("company_id") @db.Uuid
  name          String
  type          CategoryType
  flowDirection FlowDirection       @map("flow_direction")
  itemType      CategoryItemScope   @default(NONE) @map("item_type")
  isCogs        Boolean             @default(false) @map("is_cogs")
  isVariable    Boolean             @default(false) @map("is_variable")
  isDirectCost  Boolean             @default(false) @map("is_direct_cost")
  isDefault     Boolean             @default(false) @map("is_default")
  isRemoved     Boolean             @default(false) @map("is_removed")
  createdAt     DateTime            @default(now()) @map("created_at")

  company      Company?      @relation(fields: [companyId], references: [id])
  transactions Transaction[]

  @@index([companyId, isRemoved])
  @@index([name])

  @@map("categories")
}

model Item {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  type         ItemType
  basePrice    Decimal  @map("base_price") @db.Decimal(10, 2)
  stockCurrent Int      @default(0) @map("stock_current")
  isRemoved    Boolean  @default(false) @map("is_removed")
  createdAt    DateTime @default(now()) @map("created_at")

  company           Company           @relation(fields: [companyId], references: [id])
  productionBatches ProductionBatch[]
  transactions      Transaction[]     @relation("TransactionItem")
  costTransactions  Transaction[]     @relation("TransactionCostItem")

  @@index([companyId, isRemoved])
  @@index([companyId, type, isRemoved])
  @@index([name])

  @@map("items")
}

model ProductionBatch {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  itemId    String      @map("item_id") @db.Uuid
  quantity  Int
  status    BatchStatus
  batchDate  DateTime    @default(now()) @map("batch_date")
  isRemoved Boolean     @default(false) @map("is_removed")
  createdAt DateTime    @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  transactions Transaction[]

  @@index([companyId, isRemoved])
  @@index([companyId, itemId, isRemoved])

  @@map("production_batches")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  itemId      String?           @map("item_id") @db.Uuid
  batchId     String?           @map("batch_id") @db.Uuid
  costItemId  String?           @map("cost_item_id") @db.Uuid
  quantity    Int?
  unitPrice   Decimal?          @map("unit_price") @db.Decimal(10, 2)
  dollarRate   Decimal          @default(0) @map("dollar_rate") @db.Decimal(10, 2)
  amountUSD   Decimal           @map("amount_usd") @db.Decimal(10, 2)
  amountBs      Decimal         @default(0) @map("amount_bs") @db.Decimal(10, 2)
  status           TransactionStatus
  paymentMethod    PaymentMethod      @map("payment_method")
  currency         Currency
  paymentReference String?            @map("payment_reference")
  description      String?
  stockEffect      StockEffect        @default(NONE) @map("stock_effect")
  paymentDate      DateTime?          @map("payment_date")
  isRemoved        Boolean            @default(false) @map("is_removed")
  createdAt   DateTime          @default(now()) @map("created_at")

  company  Company          @relation(fields: [companyId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  item     Item?            @relation("TransactionItem", fields: [itemId], references: [id])
  batch    ProductionBatch? @relation(fields: [batchId], references: [id])
  costItem Item?            @relation("TransactionCostItem", fields: [costItemId], references: [id])

  @@index([companyId, isRemoved, createdAt])
  @@index([companyId, categoryId, isRemoved])
  @@index([companyId, itemId, isRemoved])
  @@index([companyId, status, paymentDate])
  @@index([paymentDate])

  @@map("transactions")
}