# Base de datos (pool + directo para migraciones)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=

# JWT Supabase (Settings → API → JWT Settings → clave pública EC P-256, campos x e y del JWK)
SUPABASE_JWT_JWK_X=
SUPABASE_JWT_JWK_Y=
# Opcionales (por defecto: {SUPABASE_URL}/auth/v1 y "authenticated")
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Frontend (CORS; varios orígenes separados por coma)
FRONTEND_URL=http://localhost:3000

# IA
CO_API_KEY= # Cohere API key (https://dashboard.cohere.com/)

# MCP HTTP (SSE). Deshabilitado por defecto; el chat usa herramientas vía /finance-chat
MCP_HTTP_ENABLED=false

# Servidor
PORT=3000
